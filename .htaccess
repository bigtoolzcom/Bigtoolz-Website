# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# HTTPS force karo
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Blog posts: /blog/abc/ → /blog/post.html?slug=abc
RewriteRule ^blog/([^/]+)/?$ /blog/post.html?slug=$1 [L,QSA]

# Webstories: /webstories/xyz/ → /webstories/view.html?slug=xyz
RewriteRule ^webstories/([^/]+)/?$ /webstories/view.html?slug=$1 [L,QSA]

# Remove .html extension: /about → /about.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1.html [L]

# index.html → /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1/index.html [L]

# 404 Error Page
ErrorDocument 404 /404.html

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>